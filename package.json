{
  "name": "au-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AU Studio — platform for authoring and playing phone-sim interactive fiction",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.player.config.ts && node scripts/merge-player.mjs && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b --pretty false",
    "deploy:netlify": "npm run build && npx netlify-cli deploy --dir=dist --prod",
    "deploy:surge": "npm run build && npx surge dist",
    "deploy:vercel": "npm run build && npx vercel@latest --prod",
    "export:story": "npm run build && node scripts/export-story.mjs",
    "verify:player": "node scripts/verify-player.mjs",
    "strip:bom": "node scripts/strip-bom.mjs ."
  },
  "dependencies": {
    "@xyflow/react": "^12.3.5",
    "idb-keyval": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^30.1.3",
    "puppeteer-core": "^25.15.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^2.1.4"
  }
}
